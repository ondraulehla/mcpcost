{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcpcost",
  // The Astro app plus a cron handler that sends the alert mails. See src/worker.ts.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Smart Placement: the Worker runs near D1 in one region instead of in every data centre a request lands in.
  // Isolates stay warm (a cold render costs 12 to 20 ms of CPU, a warm one 3 to 8) and one Cache API serves every
  // request, so a crawler's second visit to a page in a day is a hit. Measured with watch.yml from 2026-11-04.
  "placement": { "mode": "smart" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  // Alert mails after the daily run; the handler is idempotent, so three runs a day cost nothing extra.
  "triggers": { "crons": ["45 6,12,18 * * *"] },
  // Alert mails go out through one of two ways, see site/src/lib/watch.ts:
  // 1. Cloudflare Email Sending (Workers Paid plan): enable ulehla.dev under Email Service, then uncomment the binding.
  //    "send_email": [{ "name": "EMAIL" }],
  // 2. Resend: verify ulehla.dev at resend.com and set the secret: npx wrangler secret put RESEND_API_KEY
  // Without either, the watch form answers that the confirmation mail could not be sent.
  "vars": {
    // Cloudflare Web Analytics site token (dashboard: Analytics & Logs, Web Analytics, Manage site). Empty: no beacon is rendered.
    "CF_BEACON_TOKEN": "c4630a14eada43df926afcf0d18f91b9"
  },
  "routes": [
    { "pattern": "mcpcost.ulehla.dev", "custom_domain": true },
    // The old name stays as an alias; the middleware answers 301 to the new one. Static assets are served before
    // the Worker and prerendered pages before the middleware, so the pages crawlers read are routes, not files;
    // run_worker_first would not help here. README, "The old host", has a zone Redirect Rule that covers the rest.
    { "pattern": "mcp-pulse.ulehla.dev", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcp-pulse",
      "database_id": "f1984775-849a-4277-805e-537ea5ad7611"
    }
  ]
}
