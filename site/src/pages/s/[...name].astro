---
import Layout from '../../layouts/Layout.astro';
import { serverPage, similarByTitle, listingsOf, bundleOf } from '../../lib/db';
import { bucket, label, ms, num, tokens, date, windowShare, modelName } from '../../lib/format';
import { fixFor } from '../../lib/fixes';

const name = Astro.params.name ?? '';
// One round trip for the row, its history, its siblings, whether it ever answered, and the latest run.
const { server, history, siblings, everAnswered, run, onHost, word, ...related } = await serverPage(name);
if (!server) {
  return new Response('Not found', { status: 404 });
}
// The links to other servers. A name whose word finds fewer than three gets one more look, by the words of the title.
let similar = related.similar;
let similarWords = word && similar.length ? [word] : [];
if (similar.length < 3) {
  const byTitle = await similarByTitle(server.title, server.description, name, new Set([...onHost, ...similar].map((s) => s.name)), word ? [word] : []);
  if (byTitle.similar.length) {
    similar = [...similar, ...byTitle.similar].slice(0, 8);
    similarWords = [...similarWords, ...byTitle.words];
  }
}
// A day at the edge: the data change once a day, and a crawl that reads every server page costs the Worker one request per page per colo, not one every three hours.
Astro.response.headers.set('cache-control', 'public, max-age=300, s-maxage=86400');

const capabilities = server.capabilities ? (JSON.parse(server.capabilities) as string[]) : [];
/** The OAuth metadata of a server that needs auth, as the probe read it; see AuthMetadata in the package. */
const access = (server.auth_metadata ? JSON.parse(server.auth_metadata) : null) as { authorizationServers?: string[]; scopesSupported?: string[]; authorizationServerMetadata?: boolean; dynamicRegistration?: boolean; pkce?: boolean; grantTypes?: string[] } | null;
const authHost = (() => { try { return access?.authorizationServers?.[0] ? new URL(access.authorizationServers[0]).host : null; } catch { return null; } })();
const topTools = server.top_tools ? (JSON.parse(server.top_tools) as Array<{ name: string; tokens: number }>) : [];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const badgeMd = `[![mcpcost](${site}/badge/${name}.svg)](${site}/s/${name})`;
const badgeHtml = `<a href="${site}/s/${name}"><img src="${site}/badge/${name}.svg" alt="mcpcost" height="20"></a>`;
const reachable = history.filter((h) => h.status === 'ok' || h.status === 'auth' || h.status === 'payment').length;
// A server that never answered has a page that says only "timeout" or "error". Google reads that as a soft 404,
// so the page is noindex (links still followed) until one probe gets an answer. The sitemap applies the same rule.
// An entry the probe does not run has no result to show, so its page is noindex as well.
const answered = server.status !== 'unprobed' && (bucket(server.status) !== 'down' || history.some((h) => bucket(h.status) !== 'down') || everAnswered);
const robots = answered ? undefined : 'noindex, follow';
const heading = server.title ?? server.server_name ?? name;
/** The catalogs that list a server from outside the registry (registry_status "listed"). */
const listings = listingsOf(server);
const listed = server.registry_status === 'listed';
/** A registry entry that lists several servers, or one of those servers (registry_status "bundled"); see probe/bundles.ts. */
const bundle = bundleOf(server);
const bundled = server.registry_status === 'bundled' && bundle && 'entry' in bundle ? bundle : null;
const members = bundle && 'members' in bundle ? bundle : null;
/**
 * How the title and the summary name the server: the registry name, or for a server without a registry name of its
 * own (a catalog's, or one of a bundle) its title and host, which people search for.
 */
const who = (listed || bundled) && server.title ? `${server.title} MCP server (${server.host})` : name;
/** up, gated, noanswer or down: a failing server is down after two days of failed probes, "no answer" before. */
const group = bucket(server.status, server.failing_since, server.down_since);
const failingSince = group === 'down' || group === 'noanswer' ? (server.failing_since ?? server.probed_at) : null;
const ok = server.status === 'ok';
const exact = ok && server.claude_tokens != null;
const model = modelName(server.claude_model);
/** The number the page leads with: the exact Claude count, else the estimate. */
const cost = exact ? server.claude_tokens : server.tools_tokens;
const share = ok && cost ? ((cost / 200_000) * 100).toFixed(1) : null;
/** A PyPI package that starts only with mcp<2: the probe listed its tools with that pin (probe/stdio-run.ts). */
const pinned = server.status === 'needs_old_sdk' && server.tool_count != null;
const pinnedCost = pinned ? (server.claude_tokens ?? server.tools_tokens) : null;
const pinnedExact = pinned && server.claude_tokens != null;
/** The package stopped at the import of FastMCP, which mcp 2.0 renamed to MCPServer (FASTMCP_MOVED in probe/stdio-classify.ts). */
const fastmcpMoved = /No module named '?mcp\.server\.fastmcp/.test(server.error ?? '');
/** A start-up error of mcp 2.x that has a page of its own under /errors (src/lib/fixes.ts). */
const fix = server.url.startsWith('pypi:') ? fixFor(server.error) : undefined;
/** How a user starts a package: npx, uvx (with the pin it needs), or docker for an OCI image. An MCPB bundle is a file to open in a client. */
const runIt = server.url.startsWith('npm:')
  ? `npx -y ${server.url.slice(4)}`
  : server.url.startsWith('pypi:')
    ? `uvx ${server.status === 'needs_old_sdk' ? "--with 'mcp<2' " : ''}${server.url.slice(5).replace('==', '@')}`
    : server.url.startsWith('oci:')
      ? `docker run -i --rm ${server.url.slice(4)}`
      : null;
/** For a server that needs auth: the tool set of the publisher's open-source package, measured in a container without credentials. */
const derived =
  !ok && server.derived_status === 'ok' && (server.derived_claude_tokens ?? server.derived_tools_tokens) != null
    ? {
        name: server.derived_package!,
        registry: server.derived_registry ?? 'npm',
        tools: server.derived_tool_count,
        cost: (server.derived_claude_tokens ?? server.derived_tools_tokens)!,
        exact: server.derived_claude_tokens != null,
        probedAt: server.derived_probed_at ?? server.probed_at
      }
    : null;
const derivedShare = derived ? ((derived.cost / 200_000) * 100).toFixed(1) : null;
/** The model of a derived exact count: the run's, since the row keeps no model for it. */
const derivedModel = modelName(run?.claudeTokens?.model ?? server.claude_model);
// The run's percentiles on the same basis as the page's number: the exact count when both have it, else the estimate.
const runStats = run ? (exact && run.claudeTokens ? run.claudeTokens : run.toolsTokens) : null;
const multiple = ok && cost && runStats?.median ? cost / runStats.median : null;
const multipleText = multiple == null ? null : multiple >= 10 ? `${Math.round(multiple)}×` : `${multiple.toFixed(1)}×`;
const heavy = ok && cost != null && runStats?.p90 != null && cost > runStats.p90;
const topShare = topTools.length && server.tools_tokens ? Math.round((topTools.reduce((a, t) => a + t.tokens, 0) / server.tools_tokens) * 100) : 0;
const probeNow = server.transport !== 'stdio' ? `/check?target=${encodeURIComponent(server.url)}` : null;

/** What the publisher can do about the result. One or two sentences per cause. */
const hints: string[] = [];
if (group === 'noanswer' && server.status !== 'rate_limited') {
  hints.push(server.transport === 'stdio'
    ? `The package did not start as an MCP server at its probe on ${date(server.probed_at)}. One failed probe is not an outage: the board calls a package down when it fails again at its next probe, a week later.`
    : `No valid answer since ${date(failingSince)}. One failed probe is not an outage: the board calls a server down after two days without a valid answer. The next probe runs within a day.`);
} else if (group === 'down') {
  hints.push(`No valid answer since ${date(failingSince)}, in every probe since then.`);
}
switch (server.status) {
  case 'ok':
    if (heavy) {
      // Name the top tools only when they explain a good part of the cost; on a server with 70 even tools they do not.
      const top = topShare >= 30 ? ` Its ${topTools.length} most expensive tools are ${topShare} % of the cost.` : '';
      hints.push(`This server is in the heaviest 10 % of the registry.${top} Shorter descriptions, fewer optional parameters and fewer tools cut the cost. The command npx mcpcost --url <endpoint> --tools 50 lists every tool with its cost.`);
    }
    if (server.claude_error) hints.push(`The Anthropic count_tokens endpoint refused the tool schemas (${server.claude_error}). A client that validates schemas can refuse them too.`);
    if (!hints.length) hints.push('The server answers initialize and tools/list. Nothing to fix.');
    break;
  case 'auth':
    hints.push(`The server answers HTTP ${server.http_status ?? 401} to an unauthenticated initialize, so the probe cannot list its tools. That is correct for a private server. Some public servers answer initialize and tools/list without credentials and ask for auth on tool calls only; those get a token count here.`);
    break;
  case 'payment':
    hints.push('The server answers HTTP 402 to initialize. The probe records it as paid and does not list its tools.');
    break;
  case 'unprobed':
    hints.push(`${server.error ?? 'The probe does not run this entry yet.'} The entry is on the board so that the list holds the whole registry and says what it does not check.`);
    break;
  case 'needs_url':
    hints.push('Every URL of the registry entry has a placeholder that each user fills in, such as a tenant, a project or a host of their own. Without that value there is nothing to call, so the probe does not call the URL, and the entry is not counted as down. A client asks the user for the value.');
    break;
  case 'not_found':
    hints.push(`The endpoint answers HTTP ${server.http_status ?? 404}. The registry entry points to a URL that is not an MCP endpoint any more. Publish a new version of the registry entry with the current URL.`);
    break;
  case 'protocol_error':
    hints.push('The endpoint answers HTTP 200, but not with a valid MCP initialize result. Common causes: the URL is a web page or a REST API and not the MCP endpoint, the server answers a JSON-RPC error on initialize, or the response is HTML.');
    break;
  case 'unsupported_version':
    hints.push(`The server answers initialize with an error: it does not support the protocol version the probe asks for${run?.requestedProtocolVersion ? `, ${run.requestedProtocolVersion}` : ''}, the newest one of the TypeScript SDK. The server is up, so the board does not count it as down. A client on that SDK cannot connect until the server accepts that version; a client that offers a version the server supports can.`);
    break;
  case 'newer_protocol':
    hints.push(`The server negotiates protocol ${server.protocol_version ?? ''}, which the current TypeScript SDK refuses. Clients built on the SDK cannot connect until the server accepts the version the client offers.`);
    break;
  case 'dns':
    hints.push('The host name does not resolve. The domain has lapsed or the DNS record is gone.');
    break;
  case 'tls':
    hints.push('The TLS handshake fails: an expired or mismatched certificate, or an unsupported protocol version.');
    break;
  case 'timeout':
    hints.push('No answer within 15 seconds. The server is up but slow, or the request hangs. Some servers stall tools/list while a GET stream is open; the probe opens none.');
    break;
  case 'refused':
    hints.push('The connection is refused. Nothing listens on that host and port.');
    break;
  case 'server_error':
    hints.push(`The server answers HTTP ${server.http_status ?? '5xx'} on initialize. The error output, if any, is above.`);
    break;
  case 'rate_limited':
    hints.push('The server answered that it limits the requests of a client: HTTP 429, or a rate limit in its reply. The server is there, so the board does not count it as down. The probe sends one request at a time per host and probes a host with hundreds of entries on one day of seven, so the limit is low or shared with other users.');
    break;
  case 'install_failed':
    hints.push('npx or uvx could not install the package. The package name in the registry entry is wrong, the package is not published, or the install needs a build step.');
    break;
  case 'no_bin':
    hints.push('The package installs, but it has no executable to run. Add a bin entry (npm) or a console script entry point (PyPI).');
    break;
  case 'needs_env':
    hints.push('The server exits because an environment variable is missing. The probe starts the package without secrets. A server that starts without secrets and asks for them on the first tool call is measured.');
    break;
  case 'needs_args':
    hints.push('The server needs command line arguments that the registry entry does not list. Add them to the package arguments in the registry entry.');
    break;
  case 'needs_network':
    hints.push('The server tries to reach the network on start. The probe runs in a container with the network off, so a server that connects lazily, on the first tool call, is measured.');
    break;
  case 'needs_old_sdk':
    hints.push(`The package imports FastMCP from mcp.server.fastmcp. mcp 2.0, the Python SDK of 28 July 2026, renamed FastMCP to MCPServer, and the package asks for mcp with no upper bound, so a plain install (uvx, pip) gets mcp 2.x and the server stops at the import. Installed with mcp<2, it starts and lists its tools. The fix for the publisher: pin mcp<2 in the dependencies, for example mcp>=1.2,<2, and publish a new version, or move to MCPServer as the SDK's migration guide says. Until then, run it with uvx --with 'mcp<2'.`);
    break;
  case 'crashed':
    hints.push(fastmcpMoved
      ? 'The package stops at the import of FastMCP from mcp.server.fastmcp. mcp 2.0, the Python SDK of 28 July 2026, renamed FastMCP to MCPServer, and a plain install gets mcp 2.x. Pin mcp<2 in the dependencies, or move to MCPServer as the SDK\'s migration guide says. The error output is above.'
      : 'The process exited on start before it answered initialize. The error output is above.');
    break;
  default:
    hints.push('The probe could not complete the handshake. The error output is above.');
}
// Smithery ends its MCP connection proxy on 2026-10-31 (https://smithery.ai/future): its hosted URLs stop working then.
if (server.host === 'server.smithery.ai' || server.host.endsWith('.run.tools')) {
  const ended = new Date().toISOString().slice(0, 10) >= '2026-10-31';
  hints.unshift(`Smithery ${ended ? 'stopped' : 'stops'} its MCP connection proxy on 31 October 2026. URLs on server.smithery.ai and run.tools ${ended ? 'do not work any more' : 'stop working then'}. Publish a new version of the registry entry with the server's own URL.`);
}
// The title and the first sentence answer the question people type into a search box: "is the X MCP server down".
// The subject names the server the way a person does ("Linear MCP server"), with the registry name as the fallback.
// Titles from the registry are not unique, so the page title adds what is: the registry name, or a catalog server's host.
// A title's tagline ("Arcmira: YouTube Transcript Search", "Linear - issues and projects") stays out of the sentence.
const plainTitle = server.title?.split(/\s*[:|\u2013\u2014]\s+|\s+-\s+/)[0].replace(/\s*(mcp\s*server|mcp)\s*$/i, '').trim() || null;
const subject = plainTitle ? `${plainTitle} MCP server` : `${name} MCP server`;
const titleSubject = plainTitle ? `${subject} (${listed || bundled ? server.host : name})` : subject;
const http = server.http_status ? ` (HTTP ${server.http_status})` : '';
const pageTitle = ok
  ? `${titleSubject} status: alive, ${num(cost)} tokens of context${exact ? ` in ${model}` : ''}, ${num(server.tool_count)} tools`
  : pinned
    ? `${titleSubject} status: needs mcp<2, ${num(pinnedCost)} tokens of context${pinnedExact ? ` in ${model}` : ''}, ${num(server.tool_count)} tools`
    : derived
      ? `${titleSubject} status: ${label(server.status)}, ${num(derived.cost)} tokens of context from the publisher's package, ${num(derived.tools)} tools`
      : server.status === 'rate_limited'
        ? `${titleSubject} status: up, rate limited (HTTP 429)`
        : group === 'down'
          ? `${titleSubject} status: down since ${date(failingSince)}, ${label(server.status)}`
          : group === 'noanswer'
            ? `${titleSubject} status: no valid answer today, ${label(server.status)}`
            : `${titleSubject} status: ${label(server.status)}`;
/** One sentence that answers "is it down?" for today, from the latest probe. Null for a server the probe does not call. */
const lead = ok
  ? `Is the ${subject} down? No. It answered initialize and tools/list in the probe of ${date(server.probed_at)}.`
  : pinned
    ? `Is the ${subject} down? No. Installed with mcp<2, it started and listed its tools on ${date(server.probed_at)}.`
    : group === 'gated'
      ? `Is the ${subject} down? No. It is up and ${label(server.status)}${http}, probed ${date(server.probed_at)}.`
      : server.status === 'rate_limited'
        ? `Is the ${subject} down? No. It answered HTTP 429 on ${date(server.probed_at)}: it limits the probe's requests, so the board does not count it as down.`
        : group === 'down'
          ? `Is the ${subject} down? Yes. It has given no valid answer since ${date(failingSince)}: ${label(server.status)}${http}.`
          : group === 'noanswer'
            ? `Is the ${subject} down? It gave no valid answer in the probe of ${date(server.probed_at)}: ${label(server.status)}${http}. One failed probe is not an outage.`
            : null;
const detail = ok
  ? exact
    ? `${who} costs ${num(server.claude_tokens)} tokens of context per session in ${model}. In Claude Code it costs ${num(server.claude_tokens_cc ?? server.claude_tokens)} tokens. It has ${num(server.tool_count)} tool definitions. That is ${share} % of a 200k window. Measured ${date(server.claude_measured_at ?? server.probed_at)}.`
    : `${who} costs about ${num(server.tools_tokens)} tokens of context per session (o200k_base estimate${server.claude_error ? ', Claude refused the schema' : ''}). It has ${num(server.tool_count)} tool definitions. That is ${share} % of a 200k window. Measured ${date(server.probed_at)}.`
  : pinned
    ? `${who} does not start from a plain install: it imports FastMCP, which mcp 2.0 renamed. Its ${num(server.tool_count)} tool definitions cost ${num(pinnedCost)} tokens of context per session${pinnedExact ? ` in ${model}` : ' (o200k_base estimate)'}. Measured ${date(server.claude_measured_at && server.claude_measured_at > server.probed_at ? server.claude_measured_at : server.probed_at)}.`
  : derived
    ? `The daily probe cannot list its tools. The publisher's package ${derived.name} has ${num(derived.tools)} tool definitions that cost ${num(derived.cost)} tokens of context per session${derived.exact ? ` in ${derivedModel}` : ' (o200k_base estimate)'}, ${derivedShare} % of a 200k window. The tool definitions were read from the open-source package in a container, not from the authenticated server. Measured ${date(derived.probedAt)}.`
    : server.status === 'needs_url'
      ? `${who} has only URL templates in the official MCP registry: each user fills in an address of their own, so the probe does not call it.`
      : server.status === 'unprobed'
        ? `${who} is in the official MCP registry. ${server.error ?? 'The probe does not run it yet.'}`
        : null;
const answer = [lead, detail].filter(Boolean).join(' ') || `${who}: ${label(server.status)}${http}, probed ${date(server.probed_at)}.`;
const pageUrl = `${site}/s/${name}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: heading,
  identifier: name,
  url: pageUrl,
  applicationCategory: 'MCP server',
  operatingSystem: 'Any',
  ...(server.server_version ? { softwareVersion: server.server_version } : {}),
  ...(server.description ? { description: server.description } : {}),
  ...(server.repo ? { codeRepository: server.repo } : {}),
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'status', value: label(server.status) },
    ...(ok ? [
      ...(exact ? [
        { '@type': 'PropertyValue', name: `tool definitions token cost in ${model}`, value: server.claude_tokens, unitText: 'tokens (Anthropic count_tokens)' },
        { '@type': 'PropertyValue', name: 'tool definitions token cost in Claude Code', value: server.claude_tokens_cc, unitText: 'tokens (Anthropic count_tokens, mcp__ prefix)' }
      ] : []),
      { '@type': 'PropertyValue', name: 'tool definitions token cost estimate', value: server.tools_tokens, unitText: 'tokens (o200k_base)' },
      { '@type': 'PropertyValue', name: 'tools', value: server.tool_count },
      { '@type': 'PropertyValue', name: 'share of a 200k context window', value: Number(share), unitText: 'percent' }
    ] : []),
    ...(server.protocol_version ? [{ '@type': 'PropertyValue', name: 'MCP protocol version', value: server.protocol_version }] : [])
  ],
  dateModified: server.claude_measured_at && server.claude_measured_at > server.probed_at ? server.claude_measured_at : server.probed_at,
  isPartOf: { '@type': 'Dataset', name: 'mcpcost: health and token cost of the MCP registry', url: site, license: 'https://opensource.org/license/mit' }
};
---

<Layout title={pageTitle} description={answer} jsonld={jsonld} robots={robots} feed={{ href: `/s/${name}.xml`, title: `${name} on mcpcost` }}>
  <p class="kicker mono">{name}</p>
  <h1 class="poster">{heading}</h1>
  {lead && <p class="lede">{lead}</p>}
  {server.description && <p class={lead ? 'muted' : 'lede'}>{server.description}</p>}

  <p style="margin-top:22px">
    <span class={`tag big ${group}`}>{label(server.status)}</span>
    <span class="muted small">{group === 'down' && <> down since {date(failingSince)} ·</>}{group === 'noanswer' && <> no valid answer since {date(failingSince)} ·</>}{group === 'unprobed' ? <> in the official registry, not probed</> : <> probed {date(run?.probedAt ?? server.probed_at)}{run && server.probed_at.slice(0, 10) < run.probedAt.slice(0, 10) && <> · unchanged since {date(server.probed_at)}</>}</>}{server.http_status && <> · HTTP {server.http_status}</>}{server.auth_scheme && <> · {server.auth_scheme}</>}{server.measured_with_credentials ? <> · measured with credentials</> : null}</span>
  </p>

  {server.status === 'ok' && (
    <div class="stats" style="margin-top:1.5rem">
      <div class="stat"><b>{num(server.tool_count)}</b><span>tools</span></div>
      <div class="stat"><b>{exact ? tokens(cost) : `≈ ${tokens(cost)}`}</b><span>{exact ? `tokens in ${model}` : 'tokens, estimate'}</span></div>
      <div class="stat"><b>{exact ? windowShare(cost) : `≈ ${windowShare(cost)}`}</b><span>of Claude's 200k window</span></div>
      {multipleText && <div class="stat"><b>{multipleText}</b><span>the median server</span></div>}
      <div class="stat"><b>{ms(server.init_ms)}</b><span>to initialize</span></div>
      <div class="stat"><b>{ms(server.tools_ms)}</b><span>to list tools</span></div>
    </div>
  )}
  {pinned && (
    <>
      <div class="stats">
        <div class="stat"><b>{num(server.tool_count)}</b><span>tools, with mcp&lt;2</span></div>
        <div class="stat"><b>{pinnedExact ? tokens(pinnedCost) : `≈ ${tokens(pinnedCost)}`}</b><span>{pinnedExact ? `tokens in ${model}` : 'tokens, estimate'}</span></div>
        <div class="stat"><b>{pinnedExact ? windowShare(pinnedCost) : `≈ ${windowShare(pinnedCost)}`}</b><span>of Claude's 200k window</span></div>
      </div>
      <p class="muted small" style="margin:10px 0 0">A plain install of the package stops at the import below. These tool definitions are from a second install with <span class="mono">mcp&lt;2</span>, started in a container with the network off, on {date(server.probed_at)}.</p>
    </>
  )}
  {derived && (
    <>
      <div class="stats">
        <div class="stat"><b>{num(derived.tools)}</b><span>tools, from the package {derived.name}</span></div>
        <div class="stat"><b>{derived.exact ? tokens(derived.cost) : `≈ ${tokens(derived.cost)}`}</b><span>{derived.exact ? `tokens in ${derivedModel}` : 'tokens, estimate'}</span></div>
        <div class="stat"><b>{derived.exact ? windowShare(derived.cost) : `≈ ${windowShare(derived.cost)}`}</b><span>of Claude's 200k window</span></div>
      </div>
      <p class="muted small" style="margin:10px 0 0">The server needs auth, so these tool definitions were read from the publisher's open-source package <span class="mono">{derived.registry}:{derived.name}</span>, started in a container with placeholder values and the network off, on {date(derived.probedAt)}. Tool definitions do not depend on the token, so this is what an authorized user loads, unless the server hides tools by plan or role.</p>
    </>
  )}
  {server.status !== 'ok' && server.status !== 'unprobed' && server.error && <pre>{server.error}</pre>}

  <dl class="facts">
    {server.transport === 'stdio'
      ? runIt
        ? <><dt>Run it</dt><dd class="mono">{runIt} <span class="faint">(stdio, probed in a container with the network off)</span></dd></>
        : <><dt>Bundle</dt><dd><a href={server.url.replace(/^mcpb:/, '')} rel="noopener" class="mono break">{server.url.replace(/^mcpb:/, '')}</a> <span class="faint">(MCPB, for a client that installs bundles; probed in a container with the network off)</span></dd></>
      : <><dt>Endpoint</dt><dd class="mono">{server.url} <span class="faint">({server.transport})</span></dd></>}
    <dt>Host</dt><dd><a class="mono" href={`/servers?host=${encodeURIComponent(server.host)}`}>{server.host}</a></dd>
    {server.protocol_version && <><dt>Protocol</dt><dd class="mono">{server.protocol_version}</dd></>}
    {server.server_name && <><dt>Reports itself as</dt><dd>{server.server_name} {server.server_version}</dd></>}
    {capabilities.length > 0 && <><dt>Capabilities</dt><dd class="mono">{capabilities.join(', ')}</dd></>}
    {server.instructions_chars != null && server.status === 'ok' && <><dt>Instructions</dt><dd>{server.instructions_chars ? `${num(server.instructions_chars)} characters` : 'none'}</dd></>}
    {!ok && server.derived_package && !derived && <><dt>Package</dt><dd>The publisher's package <span class="mono">{server.derived_registry}:{server.derived_package}</span> did not list its tools in the container: {label(server.derived_status ?? 'error')}{server.derived_error ? <>, <span class="mono">{server.derived_error}</span></> : null}.</dd></>}
    {ok && cost != null && <><dt>Of a 1M window</dt><dd>{exact ? windowShare(cost, 1_000_000) : `≈ ${windowShare(cost, 1_000_000)}`} of a 1M context window{exact ? '' : ', estimate'}</dd></>}
    {derived && <><dt>Of a 1M window</dt><dd>{derived.exact ? windowShare(derived.cost, 1_000_000) : `≈ ${windowShare(derived.cost, 1_000_000)}`} of a 1M context window{derived.exact ? '' : ', estimate'}</dd></>}
    {ok && server.claude_error && <><dt>Claude count</dt><dd>The count_tokens endpoint refused the tool schemas: <span class="mono">{server.claude_error}</span>. The estimate stands in.</dd></>}
    {exact && <><dt>Count</dt><dd>{tokens(server.claude_tokens)} tokens in {model}, exact, measured {date(server.claude_measured_at)}.{server.measured_with_credentials ? ' Measured with credentials, so this is what an authorized user gets.' : ''} With the Claude Code prefix <span class="mono">mcp__…__</span> on each tool name: {tokens(server.claude_tokens_cc ?? server.claude_tokens)}. The o200k_base estimate is {tokens(server.tools_tokens)}. Counted again when the tool definitions change. <a href="/methodology#tokens">Method</a>.</dd></>}
    {ok && server.gemini_tokens != null && <><dt>Gemini</dt><dd>{tokens(server.gemini_tokens)} tokens in {server.gemini_model}, exact, from the Gemini countTokens endpoint, measured {date(server.gemini_measured_at)}.</dd></>}
    {ok && server.gemini_tokens == null && server.gemini_error && <><dt>Gemini</dt><dd>The countTokens endpoint refused the tool schemas: <span class="mono">{server.gemini_error}</span>.</dd></>}
    {server.status === 'auth' && (server.auth_kind || server.auth_documentation) && (
      <>
        <dt>Getting access</dt>
        <dd>
          {server.auth_kind === 'oauth-dcr' && <>OAuth with dynamic client registration. A client such as Claude Code, Cursor or <span class="mono">npx mcpcost auth {server.url}</span> registers itself and opens the consent page; the publisher has nothing to set up for you.</>}
          {server.auth_kind === 'oauth' && <>OAuth without dynamic client registration{access?.authorizationServerMetadata === false ? ' (the authorization server did not answer the metadata request)' : ''}. Ask the publisher for a client id first; with it, a client can run the consent.</>}
          {server.auth_kind === 'token' && <>A key or token from the publisher, sent in the Authorization header ({server.auth_scheme}). The server publishes no OAuth metadata. Store the key once: <span class="mono">npx mcpcost auth {server.url} --header "Authorization: {server.auth_scheme} …"</span>.</>}
          {server.auth_kind === 'unknown' && <>The server answers HTTP {server.http_status} with no WWW-Authenticate header and no OAuth metadata, so the publisher's documentation is the only guide.</>}
          {server.auth_documentation && <> <a href={server.auth_documentation} rel="noopener" class="break">The publisher's guide to getting access</a>.</>}
          {authHost && <><br /><span class="muted small">Authorization server <span class="mono">{authHost}</span>{access?.pkce ? ', PKCE S256' : ''}{access?.grantTypes?.length ? <>, grants <span class="mono">{access.grantTypes.join(', ')}</span></> : null}.</span></>}
          {access?.scopesSupported?.length ? <><br /><span class="muted small">Scopes <span class="mono">{access.scopesSupported.join(' ')}</span>.</span></> : null}
          {server.auth_kind && <><br /><span class="muted small">Read from the server's public OAuth metadata, without a token. <a href="/methodology#access">Method</a>.</span></>}
        </dd>
      </>
    )}
    {server.repo && <><dt>Repository</dt><dd><a href={server.repo} rel="noopener" class="break">{server.repo}</a></dd></>}
    {server.website && <><dt>Website</dt><dd><a href={server.website} rel="noopener" class="break">{server.website}</a></dd></>}
    {bundled
      ? <><dt>Registry</dt><dd>One of the {bundled.servers} servers of the registry entry <a href={`/s/${bundled.entry}`}>{bundled.entry}</a>, which lists them under one name. The board measures each of them on its own.{listings.length > 0 && <> Also listed on its own in {listings.map((l, i) => <>{i ? ' and ' : ''}<a href={l.url} rel="noopener">{l.name}</a></>)}.</>}</dd></>
      : listed
      ? <><dt>Registry</dt><dd>Not in the official registry. Listed in {listings.map((l, i) => <>{i ? ' and ' : ''}<a href={l.url} rel="noopener">{l.name}</a></>)}, so the daily probe measures it with the registry servers. <a href="https://registry.modelcontextprotocol.io" rel="noopener">Publish it</a> and it gets its registry name here.</dd></>
      : server.registry_status === 'tracked'
      ? <><dt>Registry</dt><dd>Not in the official registry. Tracked on request since {date(server.registry_updated_at)}. <a href="https://registry.modelcontextprotocol.io" rel="noopener">Publish it</a> and it gets its registry name here.</dd></>
      : <><dt>Registry</dt><dd>{server.registry_status}, updated {date(server.registry_updated_at)} · <a href={`https://registry.modelcontextprotocol.io/v0/servers?search=${encodeURIComponent(name)}`} rel="noopener">registry entry</a></dd></>}
    {members && <><dt>Servers</dt><dd>The entry lists {members.servers} servers under one name. This page measures the first one, <span class="mono break">{server.host}</span>. The others have pages of their own: {members.members.map((m, i) => <>{i ? ', ' : ''}<a href={`/s/${m.name}`} class="break">{m.name.replace(/^url\//, '')}</a></>)}.</dd></>}
    {history.length > 1 && <><dt>Changes</dt><dd>{history.length} recorded, reachable in {reachable} of them. A row is added when the result, the tool count or the cost changes.</dd></>}
  </dl>

  {topTools.length > 0 && (
    <section class="panel" aria-labelledby="tools-h">
      <h2 id="tools-h" class="panel-title">Most expensive tools</h2>
      <p class="muted small">{exact && server.tools_tokens ? `The Claude column scales the o200k estimate of each tool by this server's ratio of exact to estimate, ${((server.claude_tokens as number) / server.tools_tokens).toFixed(2)}×.` : 'Estimates with the o200k_base tokenizer.'}</p>
      <div class="frame">
        <table>
          <thead><tr><th>Tool</th>{exact && server.tools_tokens && <th class="num">≈ Claude tokens</th>}<th class="num">o200k estimate</th><th class="num">Share of this server</th></tr></thead>
          <tbody>
            {topTools.map((t) => (
              <tr><td class="mono break">{t.name}</td>{exact && server.tools_tokens && <td class="num">{num(Math.round((t.tokens * server.claude_tokens!) / server.tools_tokens))}</td>}<td class="num">{num(t.tokens)}</td><td class="num">{server.tools_tokens ? Math.round((t.tokens / server.tools_tokens) * 100) : 0} %</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <p class="muted small"><a href={`/compare?s=${encodeURIComponent(name)}`}>Compare this server with others</a>{siblings.length > 0 && <>, or <a href={`/compare?s=${encodeURIComponent(name)}${siblings.slice(0, 4).map((s) => `&s=${encodeURIComponent(s.name)}`).join('')}`}>with the servers that share its tool set</a></>}.</p>

  {siblings.length > 0 && (
    <section class="panel" aria-labelledby="same-h">
      <h2 id="same-h" class="panel-title">Same tool set as {num(server.toolset_siblings)} other server{server.toolset_siblings === 1 ? '' : 's'}</h2>
      <p class="muted small">These registry entries have the same tool names and the same schema sizes.</p>
      <ul>
        {siblings.map((s) => <li><a href={`/s/${s.name}`}>{s.name}</a> <span class="faint mono">{s.host}</span></li>)}
        {(server.toolset_siblings ?? 0) > siblings.length && <li class="muted">and {num((server.toolset_siblings ?? 0) - siblings.length)} more</li>}
      </ul>
    </section>
  )}

  {(onHost.length > 0 || similar.length > 0) && (
    <section class="panel" aria-labelledby="more-h">
      <h2 id="more-h" class="panel-title">More servers</h2>
      {onHost.length > 0 && (
        <>
          <p class="muted small">Other registry entries on <span class="mono">{server.host}</span>{(onHost.length >= 8) && <>, the ones next to this name; <a href={`/servers?host=${encodeURIComponent(server.host)}`}>all of them</a></>}.</p>
          <ul>
            {onHost.map((s) => <li><a href={`/s/${s.name}`} class="break">{s.title ?? s.name}</a>{s.title && <> <span class="faint mono">{s.name}</span></>} <span class="faint">· {label(s.status)}</span></li>)}
          </ul>
        </>
      )}
      {similar.length > 0 && (
        <>
          <p class="muted small">Servers that mention {similarWords.map((w, i) => <>{i ? ' or ' : ''}<b>{w}</b></>)}.</p>
          <ul>
            {similar.map((s) => <li><a href={`/s/${s.name}`} class="break">{s.title ?? s.name}</a>{s.title && <> <span class="faint mono">{s.name}</span></>} <span class="faint">· {label(s.status)}</span></li>)}
          </ul>
        </>
      )}
    </section>
  )}

  {history.length > 1 && (
    <section class="panel" aria-labelledby="history-h">
      <h2 id="history-h" class="panel-title">History</h2>
      <p class="muted small">We add a row when the result changes. A server with no change keeps its last row.</p>
      <div class="frame">
        <table>
          <thead><tr><th>Probed</th><th>Result</th><th class="num">Init</th><th class="num">Tools</th><th class="num">Claude</th><th class="num">o200k</th></tr></thead>
          <tbody>
            {history.map((h) => (
              <tr><td class="mono">{h.probed_at.slice(0, 16).replace('T', ' ')}</td><td><span class={`tag ${bucket(h.status)}`}>{label(h.status)}</span></td><td class="num">{ms(h.init_ms)}</td><td class="num">{num(h.tool_count)}</td><td class="num">{tokens(h.claude_tokens)}</td><td class="num faint">{tokens(h.tools_tokens)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <div class="cta">
      <section class="panel" aria-labelledby="badge-h">
        <h2 id="badge-h" class="panel-title">Badge for the README</h2>
        <p style="margin:0"><img src={`/badge/${name}.svg`} alt={`mcpcost: ${label(server.status)}`} height="20" /></p>
        <p class="muted small" style="margin:0.75rem 0 0">The result of the latest probe, the tool count and the token cost. The feed has an entry for every probe that changed them.</p>
        <div class="cells-row">
          <button type="button" data-copy={badgeMd}>Copy Markdown</button>
          <button type="button" data-copy={badgeHtml}>Copy HTML</button>
          <a href={`/s/${name}.xml`}>Atom feed</a>
        </div>
      </section>
      <section class="panel" aria-labelledby="mail-h">
        <h2 id="mail-h" class="panel-title">A mail when this server changes</h2>
        <form class="checkform" method="post" action="/watch">
          <input type="hidden" name="server" value={name} />
          <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" aria-label="E-mail address" />
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
          <button type="submit">Watch</button>
        </form>
        <p class="muted small" style="margin:8px 0 0">Stops answering, comes back, tool set or cost changes. One confirmation mail first, a stop link in every mail.</p>
      </section>
  </div>

  <section class="panel" aria-labelledby="publisher-h">
    <h2 id="publisher-h" class="panel-title">For the publisher</h2>
    <ul>
      {hints.map((h) => <li>{h}</li>)}
    </ul>
    {fix && <p>The cause and the fix, with the code before and after: <a href={`/errors/${fix.slug}`} class="break mono">{fix.error}</a></p>}
    {probeNow && <p class="muted small">Fixed something? <a href={probeNow}>Probe it now</a>, with the same steps as the daily run. This page updates with the next daily run.</p>}
  </section>

</Layout>

<style>
  .cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 1.5rem 0 0;
  }
  .cta + .panel {
    margin-top: 1.5rem;
  }
  .cta > .panel {
    margin: 0;
    min-width: 0;
  }
  @media (width <= 760px) {
    .cta {
      grid-template-columns: 1fr;
    }
  }
</style>
