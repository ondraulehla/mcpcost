---
import '@fontsource/anton/latin.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import antonWoff2 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import groteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import Emblem from '../components/Emblem.astro';
import CostMark from '../components/CostMark.astro';
import { env } from 'cloudflare:workers';
import { cardFor, CARD_HEIGHT, CARD_WIDTH, type Preview } from '../lib/og';

interface Props {
  title: string;
  description?: string;
  /** Structured data for the page, rendered as JSON-LD. */
  jsonld?: unknown;
  /** Robots meta, for example "noindex, follow" on list variants that crawlers should not fetch. */
  robots?: string;
  /** An Atom feed for this page, in place of the site-wide changes feed. */
  feed?: { href: string; title: string };
  /** The social preview image of the page. Without it, the card of the page in src/lib/og.ts, else the default card. */
  image?: Preview;
}
const {
  title,
  description = 'Is this MCP server alive? What does it cost your context window? Daily health and token cost of every remote and package server in the official MCP registry.',
  jsonld,
  robots,
  feed,
  image
} = Astro.props;
// A prerendered page has the file name in the URL (/methodology.html); the canonical form is the bare path.
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const nav: Array<[string, string]> = [
  ['/', 'Overview'],
  ['/servers', 'Servers'],
  ['/check', 'Check'],
  ['/compare', 'Compare'],
  ['/statistics', 'Statistics'],
  ['/changes', 'Changes'],
  ['/methodology', 'Method']
];
const year = new Date().getFullYear();
// The canonical page is the path alone: /s/<name>?x=1 is /s/<name>. A noindex variant (a sorted or later list page)
// stays its own canonical; noindex plus a canonical that points elsewhere are two signals that contradict each other.
const noindex = /\bnoindex\b/.test(robots ?? '');
const canonical = new URL(noindex ? path + Astro.url.search : path, Astro.site ?? Astro.url).toString();
// The home page is the brand page: its title names the product and says what it does. Every other page adds the brand after its own title.
const HOME_TITLE = 'mcpcost: health and token cost of every MCP server';
const fullTitle = title === 'mcpcost' ? HOME_TITLE : `${title} · mcpcost`;
// Structured data. A page with its own data sends it; every other indexable page tells search engines that "mcpcost" is the
// name of this website, so the one-word query is a brand query and not "mcp cost".
const siteUrl = new URL('/', Astro.site ?? Astro.url).toString();
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'mcpcost',
  alternateName: 'mcpcost.ulehla.dev',
  url: siteUrl,
  description
};
const structured = jsonld ?? (noindex ? undefined : website);
// The picture that a shared link shows: a static PNG, served without the Worker. Crawlers need its absolute URL.
const preview: Preview = image ?? cardFor(path);
const previewUrl = new URL(preview.src, Astro.site ?? Astro.url).toString();
// Cloudflare Web Analytics: page views without cookies. The token is the CF_BEACON_TOKEN var in wrangler.jsonc; no token, no script.
const beaconToken = import.meta.env.DEV ? '' : ((env as unknown as { CF_BEACON_TOKEN?: string }).CF_BEACON_TOKEN ?? '').trim();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <script is:inline>
      // Before paint: the stored choice, else the system setting. No flash of the wrong theme.
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.dataset.theme = t === 'light' || t === 'dark' ? t : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/atom+xml" title={feed?.title ?? 'mcpcost: what changed'} href={feed?.href ?? '/changes.xml'} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={antonWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={groteskWoff2} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="mcpcost" />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content={String(preview.width ?? CARD_WIDTH)} />
    <meta property="og:image:height" content={String(preview.height ?? CARD_HEIGHT)} />
    <meta property="og:image:alt" content={preview.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={previewUrl} />
    <meta name="twitter:image:alt" content={preview.alt} />
    <meta name="theme-color" content="#f6f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1a17" media="(prefers-color-scheme: dark)" />
    <meta name="msvalidate.01" content="4F4EE13471EED503A00DC72F10CE2BB9" />
    {structured && <script type="application/ld+json" set:html={JSON.stringify(structured)} />}
  </head>
  <body>
    <header class="site-head">
      <div class="head-row">
        <a href="/" class="brand" aria-label="mcpcost home">
          <CostMark class="mark" />
          <span class="wordmark">mcpcost</span>
        </a>
        <script is:inline>
          // The trace runs to the end once started; a new hover waits for it to finish.
          (function () {
            var brand = document.querySelector('.brand');
            var mark = brand && brand.querySelector('.mark');
            if (!mark) return;
            brand.addEventListener('pointerenter', function () { mark.classList.add('play'); });
            var ended = 0;
            mark.addEventListener('animationend', function () { if (++ended >= 3) { ended = 0; mark.classList.remove('play'); } });
          })();
        </script>
        <nav aria-label="Main" class="nav-main">
          {nav.map(([href, text]) => (
            <a href={href} class="nav-roll" aria-current={path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined}>
              <span class="nav-roll__stack"><span>{text}</span><span class="nav-roll__accent" aria-hidden="true">{text}</span></span>
            </a>
          ))}
        </nav>
        <div class="head-cells">
          <button type="button" class="cell-flood cell-icon theme-toggle" data-theme-toggle aria-label="Switch between light and dark" title="Light / dark">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
          </button>
          <details class="menu" data-menu>
            <summary class="cell-flood cell-icon" aria-label="Menu">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            </summary>
            <nav aria-label="Menu" class="menu-panel">
              {nav.map(([href, text]) => (
                <a href={href} aria-current={path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined}>{text}</a>
              ))}
              <a href="https://github.com/ondraulehla/mcpcost" rel="noopener">GitHub</a>
              <a href="https://www.npmjs.com/package/mcpcost" rel="noopener">npx mcpcost</a>
            </nav>
          </details>
          <a href="https://github.com/ondraulehla/mcpcost" rel="noopener" class="cell-flood cell-icon cell-optional" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
          </a>
          <a href="https://www.npmjs.com/package/mcpcost" rel="noopener" class="cell-flood cell-icon cell-optional" aria-label="npm package mcpcost" title="npm: mcpcost">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"></path></svg>
          </a>
        </div>
      </div>
    </header>
    <script is:inline>
      (function () {
        // The theme toggle: the stored choice flips, with a view transition when motion is allowed.
        document.querySelector('[data-theme-toggle]').addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          var apply = function () {
            document.documentElement.dataset.theme = next;
            try { localStorage.setItem('theme', next); } catch (e) {}
          };
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches && document.startViewTransition) {
            document.documentElement.classList.add('theme-switching');
            document.startViewTransition(apply).finished.finally(function () { document.documentElement.classList.remove('theme-switching'); });
          } else {
            apply();
          }
        });
        // The menu closes on a click outside it and on Escape.
        var menu = document.querySelector('[data-menu]');
        if (!menu) return;
        document.addEventListener('click', function (e) { if (menu.open && !menu.contains(e.target)) menu.open = false; });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && menu.open) menu.open = false; });
      })();
    </script>
    <main>
      <slot />
    </main>
    <script is:inline>
      // Every code block gets a Copy cell. The text goes to the clipboard; the label says Copied! for a moment.
      (function () {
        if (!navigator.clipboard) return;
        // Buttons with data-copy: the attribute goes to the clipboard.
        document.querySelectorAll('[data-copy]').forEach(function (btn) {
          var label = btn.textContent;
          btn.addEventListener('click', function () {
            var done = function () { btn.textContent = 'Copied!'; setTimeout(function () { btn.textContent = label; }, 1500); };
            navigator.clipboard.writeText(btn.dataset.copy).then(done, done);
          });
        });
        document.querySelectorAll('main pre').forEach(function (pre) {
          if (pre.closest('.copy-row')) return;
          var box = document.createElement('div');
          box.className = 'copyable';
          pre.parentNode.insertBefore(box, pre);
          box.appendChild(pre);
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'copy-btn';
          btn.textContent = 'Copy';
          btn.setAttribute('aria-label', 'Copy to the clipboard');
          btn.addEventListener('click', function () {
            var done = function () { btn.textContent = 'Copied!'; setTimeout(function () { btn.textContent = 'Copy'; }, 1500); };
            navigator.clipboard.writeText(pre.textContent).then(done, done);
          });
          box.appendChild(btn);
        });
      })();
    </script>
    <footer class="site-foot">
      <div class="foot-row">
        <a href="https://ulehla.dev" rel="me noopener" class="brand-foot">
          <Emblem class="emblem" />
          <span>© {year} Ondřej Úlehla</span>
        </a>
        <nav aria-label="Footer" class="foot-cells">
          <a href="https://ulehla.dev" rel="me noopener" class="cell-flood cell-text">ulehla.dev</a>
        </nav>
      </div>
    </footer>
    {beaconToken && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beaconToken })}></script>}
  </body>
</html>

<style is:global>
  /* Tokens: the palette of ulehla.dev. Chart hues are a separate, validated set. */
  :root {
    --surface: oklch(95.9% 0.023 84);
    --panel: oklch(93.2% 0.027 83);
    --ink: oklch(21% 0.012 55);
    --ink-muted: oklch(43% 0.016 55);
    --ink-faint: oklch(50% 0.016 62);
    --line: oklch(86.5% 0.028 82);
    --accent: oklch(55% 0.19 38);
    --accent-strong: oklch(47% 0.19 38);
    --accent-soft: oklch(90.5% 0.05 55);
    --glow: oklch(55% 0.19 38 / 0.1);
    --up: oklch(52% 0.13 150);
    --up-soft: oklch(92% 0.05 150);
    --gated: oklch(50% 0.09 250);
    --gated-soft: oklch(92% 0.03 250);
    --chart-up: oklch(52% 0.13 150);
    --chart-gated: oklch(50% 0.12 250);
    --chart-accent: oklch(55% 0.19 38);
    --font-sans: 'Inter Variable', Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-display: 'Space Grotesk Variable', 'Space Grotesk', var(--font-sans);
    --font-poster: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    --gutter: clamp(20px, 3vw, 32px);
    --head-h: 5.25rem;
    --ease-out-quint: cubic-bezier(0.22, 1, 0.36, 1);
    color-scheme: light;
  }
  /* Dark: the stored choice, or the system setting when nothing is stored. */
  :root[data-theme="dark"] {
    --surface: oklch(17% 0.008 65);
    --panel: oklch(21% 0.01 65);
    --ink: oklch(93% 0.012 80);
    --ink-muted: oklch(70% 0.016 70);
    --ink-faint: oklch(60% 0.016 65);
    --line: oklch(29% 0.012 65);
    --accent: oklch(70% 0.17 38);
    --accent-strong: oklch(77% 0.15 45);
    --accent-soft: oklch(27% 0.05 45);
    --glow: oklch(70% 0.17 38 / 0.12);
    --up: oklch(72% 0.14 150);
    --up-soft: oklch(26% 0.05 150);
    --gated: oklch(72% 0.09 250);
    --gated-soft: oklch(26% 0.04 250);
    --chart-up: oklch(66% 0.14 150);
    --chart-gated: oklch(66% 0.12 250);
    --chart-accent: oklch(66% 0.17 38);
    color-scheme: dark;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --surface: oklch(17% 0.008 65);
      --panel: oklch(21% 0.01 65);
      --ink: oklch(93% 0.012 80);
      --ink-muted: oklch(70% 0.016 70);
      --ink-faint: oklch(60% 0.016 65);
      --line: oklch(29% 0.012 65);
      --accent: oklch(70% 0.17 38);
      --accent-strong: oklch(77% 0.15 45);
      --accent-soft: oklch(27% 0.05 45);
      --glow: oklch(70% 0.17 38 / 0.12);
      --up: oklch(72% 0.14 150);
      --up-soft: oklch(26% 0.05 150);
      --gated: oklch(72% 0.09 250);
      --gated-soft: oklch(26% 0.04 250);
      --chart-up: oklch(66% 0.14 150);
      --chart-gated: oklch(66% 0.12 250);
      --chart-accent: oklch(66% 0.17 38);
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { background: var(--surface); color: var(--ink); font-family: var(--font-sans); font-size: 16px; line-height: 1.5; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-rendering: optimizeLegibility; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { margin: 0; min-height: 100svh; display: flex; flex-direction: column; }
  a { color: inherit; text-decoration: none; }
  ::selection { background: var(--accent); color: var(--surface); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  html.theme-switching::view-transition-old(root), html.theme-switching::view-transition-new(root) { animation-duration: 0.4s; animation-timing-function: ease-in-out; }
  @supports (-moz-appearance: none) { html { scrollbar-width: thin; scrollbar-color: var(--accent) transparent; } }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--accent); border: 3px solid var(--surface); }
  ::-webkit-scrollbar-thumb:hover { background: var(--accent-strong); }

  /* cells: ink floods from the bottom on hover */
  .cell-flood, .cell-flood-group { color: var(--ink-muted); background-image: linear-gradient(var(--ink), var(--ink)); background-position: bottom; background-repeat: no-repeat; background-size: 100% 0%; transition: background-size 0.28s var(--ease-out-quint), color 0.18s 60ms; }
  .cell-flood:hover, .cell-flood:focus-visible, .group:hover .cell-flood-group, .group:focus-within .cell-flood-group { color: var(--surface); background-size: 100% 100%; }
  .cell-icon { display: flex; align-items: center; justify-content: center; width: 4rem; border: 0; border-left: 1px solid var(--line); background-color: transparent; font: inherit; cursor: pointer; padding: 0; }
  .cell-icon svg { width: 1.125rem; height: 1.125rem; }
  .cell-text { display: flex; align-items: center; justify-content: center; padding: 0 1.5rem; border-left: 1px solid var(--line); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; white-space: nowrap; }

  /* header: sticky, the surface at 95 % over a blur, the brand left, text nav in the centre, square cells on the right */
  .site-head { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid var(--line); background: color-mix(in oklab, var(--surface) 95%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .head-row { display: flex; align-items: stretch; justify-content: space-between; height: var(--head-h); }
  .brand { display: flex; align-items: center; gap: 0.875rem; padding: 0 var(--gutter); color: var(--ink); }
  .wordmark { font-family: var(--font-mono); font-size: 1.05rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600; }
  .mark { width: 2.25rem; height: 2.25rem; flex: 0 0 auto; color: var(--accent); }
  .mark .bar { transform-origin: 50% 27px; }
  @media (prefers-reduced-motion: no-preference) {
    .mark.play .bar { animation: cost-grow 0.9s cubic-bezier(0.4, 0, 0.2, 1) 1 both; }
    .mark.play .bar:nth-child(2) { animation-delay: 0.08s; }
    .mark.play .bar:nth-child(3) { animation-delay: 0.16s; }
  }
  @keyframes cost-grow {
    0% { transform: scaleY(0.15); }
    60% { transform: scaleY(1.06); }
    100% { transform: scaleY(1); }
  }
  .nav-main { display: none; flex: 1; align-items: center; justify-content: center; gap: 1.75rem; padding: 0 1.5rem; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .nav-roll { position: relative; padding: 0.5rem 0; color: var(--ink-muted); }
  .nav-roll__stack { display: inline-flex; flex-direction: column; height: 1.1em; line-height: 1.1; overflow: hidden; }
  .nav-roll__stack span { transition: transform 0.32s cubic-bezier(0.76, 0, 0.24, 1); }
  .nav-roll__accent { color: var(--accent); }
  .nav-roll:hover .nav-roll__stack span, .nav-roll:focus-visible .nav-roll__stack span { transform: translateY(-100%); }
  .nav-roll[aria-current] { color: var(--accent); }
  .nav-roll[aria-current]:hover .nav-roll__stack span, .nav-roll[aria-current]:focus-visible .nav-roll__stack span { transition: none; transform: none; }
  .nav-roll[aria-current]::after { content: ''; position: absolute; left: 0; right: 0; top: calc(50% + 0.85em); height: 1.5px; background: var(--accent); }
  .head-cells { display: flex; align-items: stretch; }
  .theme-toggle .icon-sun { display: none; }
  :root[data-theme="dark"] .theme-toggle .icon-sun { display: block; }
  :root[data-theme="dark"] .theme-toggle .icon-moon { display: none; }
  .menu { position: relative; display: flex; }
  .menu summary { list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-panel { position: absolute; top: 100%; right: 0; z-index: 50; display: flex; flex-direction: column; gap: 0.25rem; width: 13rem; padding: 0.5rem; border: 1px solid var(--line); background: var(--panel); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
  .menu-panel a { padding: 0.5rem 0.75rem; font-size: 0.875rem; font-weight: 500; color: var(--ink-muted); }
  .menu-panel a:hover { background: var(--surface); color: var(--ink); }
  .menu-panel a[aria-current] { color: var(--accent); }
  @media (min-width: 1100px) { .nav-main { display: flex; } .menu { display: none; } }
  @media (max-width: 640px) {
    :root { --head-h: 4.25rem; }
    .cell-icon { width: 3.25rem; }
    .cell-optional { display: none; }
    .mark { width: 1.9rem; height: 1.9rem; }
    .wordmark { font-size: 0.95rem; letter-spacing: 0.16em; }
    .brand { gap: 0.625rem; }
  }

  /* footer: one row, the emblem and the copyright left, cells right */
  .site-foot { margin-top: auto; border-top: 1px solid var(--line); }
  .foot-row { display: flex; align-items: stretch; justify-content: space-between; min-height: 3.75rem; }
